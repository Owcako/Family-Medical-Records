# Copy this file to .env in the project root. Restart the backend after changes.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Optional: used together after a primary HTTP 429 quota/rate-limit response.
BACKUP_API_KEY=
BACKUP_BASE_URL=
BACKUP_MODEL=
# Uses OpenAI Chat Completions, image inputs, and strict function calling.
# PDF pages are rendered locally and sent as images. A custom base URL must
# support Chat Completions with image inputs and function tools.
LIBRARY_PATH=data/library.sqlite3
